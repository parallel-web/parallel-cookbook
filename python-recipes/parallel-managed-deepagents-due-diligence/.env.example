# LangSmith personal API key and the workspace to deploy into.
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=

# The agent runs on openai:gpt-5.5 (set in agent.py). `mda deploy` uploads this
# key to the deployment as a secret.
OPENAI_API_KEY=

# Optional, for run_hosted.py: the Agent Server URL printed by `mda deploy`.
LANGGRAPH_URL=

# No Parallel account or Parallel API key is needed.
