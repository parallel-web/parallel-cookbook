# Required for the pipeline (pnpm sheet / coverage / deepen / monitors / callday / images /
# profiles, and the webhook and cron routes on a deployment). Server-only.
# Get one at https://platform.parallel.ai. The pages alone need no key.
PARALLEL_API_KEY=

# Deployment only: where Parallel sends task_run.status and monitor events.
# WEBHOOK_URL=https://your-domain.example/api/webhooks/parallel
# Account signing secret from Parallel Settings → Webhooks.
# PARALLEL_WEBHOOK_SECRET=

# Deployment only: a private Vercel Blob store for pipeline state (set by connecting the
# store to the project). Locally, state lives in data/ and output/ unless this is set.
# BLOB_READ_WRITE_TOKEN=

# Required when enabling the optional Vercel Cron schedule.
# CRON_SECRET=

# Optional: a folder with Parallel's licensed brand fonts. Without it the app uses Geist.
# BRAND_FONTS_DIR=/path/to/fonts

# Optional: where the header's "Source code" link points.
# NEXT_PUBLIC_SOURCE_URL=https://github.com/<org>/<repo>/tree/main/said-and-done

# Optional overrides (defaults shown).
# PARALLEL_API_BASE_URL=https://api.parallel.ai
# PARALLEL_REQUEST_TIMEOUT_MS=120000
